# Required for AI replies
GEMINI_API_KEY=replace_with_your_google_ai_studio_key
GROQ_API_KEY=replace_with_your_groq_key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MULTIMODAL_MODEL=gemini-3.8-flash

# Authentication / database
APP_ENV=development
JWT_SECRET=replace_with_a_long_random_secret
ADMIN_USERNAME=admin
# Set a strong private password in your local/deployment environment; never commit it.
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.com
WEBHOOK_SHARED_SECRET=replace_with_a_long_random_shared_secret
FRONTEND_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DATABASE_URL=sqlite:///./sql_app.db

# Optional: Meta WhatsApp Cloud API. Leave blank until configured in Meta.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Default is the current Graph API version; override only if needed.
WHATSAPP_API_VERSION=v26.0
# Local default; deployment Procfile sets this from $PORT.
VAIDYA_INTERNAL_BASE_URL=http://127.0.0.1:8000
