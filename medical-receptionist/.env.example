# Required for AI replies
GEMINI_API_KEY=replace_with_your_google_ai_studio_key
GROQ_API_KEY=replace_with_your_groq_key
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MULTIMODAL_MODEL=gemini-3.8-flash

# Authentication / database
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENVIRONMENT=development
# Optional first-run bootstrap. Use a unique username and password >= 12 chars.
ADMIN_USERNAME=
ADMIN_PASSWORD=
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Use Redis in multi-worker production deployments for shared rate limits.
RATE_LIMIT_STORAGE_URI=memory://
# Keep true for a single API worker; disable on API replicas when running one separate scheduler process.
ENABLE_SCHEDULER=true
CLINIC_NAME=Your Clinic Name
CLINIC_ADDRESS=
CLINIC_TIMEZONE=Asia/Kolkata
CLINIC_OPEN_HOUR=9
CLINIC_CLOSE_HOUR=18
# Python weekday numbers: Monday=0 ... Sunday=6. Default keeps all days enabled.
CLINIC_WORKING_DAYS=0,1,2,3,4,5,6
# Comma-separated ISO dates, e.g. 2026-12-25,2027-01-01
CLINIC_HOLIDAYS=
# Optional comma-separated breaks, e.g. 13:00-14:00
CLINIC_BREAKS=
APPOINTMENT_DURATION_MINUTES=30
GOOGLE_CALENDAR_ID=primary
# Local desktop OAuth: set true for the first run, then authorize in the browser.
# Keep client_secret.json and token.json local; never commit either file.
GOOGLE_CALENDAR_ALLOW_OAUTH_FLOW=false
# Optional service-account JSON; share the clinic calendar with its client_email.
GOOGLE_SERVICE_ACCOUNT_JSON=
DATABASE_URL=sqlite:///./sql_app.db

# Cloudflare Turnstile: public site key is browser-visible; secret key stays server-side.
# Both are required to enable public chat in production.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Internal HMAC boundary for /webhook. Set a unique random secret in production.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
VAIDYA_INTERNAL_WEBHOOK_SECRET=
# Local-only convenience for direct /webhook calls; production ignores this bypass.
ALLOW_UNAUTHENTICATED_WEBHOOK=true

# Optional: Meta WhatsApp Cloud API. Leave blank until configured in Meta.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Default is the current Graph API version; override only if needed.
WHATSAPP_API_VERSION=v26.0
# Local default; deployment Procfile sets this from $PORT.
VAIDYA_INTERNAL_BASE_URL=http://127.0.0.1:8000
